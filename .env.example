# Optional overrides. The local launcher supplies TUBESCOPE_API_URL automatically.
TUBESCOPE_API_URL=http://127.0.0.1:8765
# Absolute path recommended when overriding the backend SQLite location.
# TUBESCOPE_DB=/absolute/path/to/tubescope.sqlite3
# Optional separate Next.js build directory; use the same value for build/start.
# TUBESCOPE_NEXT_DIST_DIR=.next-preview
